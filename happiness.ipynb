import pandas as pd
import matplotlib.pyplot as plt
import seaborn as sns

# 1. Load the dataset
# Ensure the file 'happiness_2017.xlsx - in.csv' is in your directory
df = pd.read_csv('happiness_2017.xlsx - in.csv')

# 2. Descriptive Statistics
# This provides mean, standard deviation, min, max, and quartiles for all numeric columns
print("Descriptive Statistics:")
print(df.describe())

# Save descriptive statistics to a CSV file
df.describe().to_csv('descriptive_statistics.csv')

# 3. Data Visualization

# Set the visual style for seaborn
sns.set(style="whitegrid")

# --- Plot 1: Distribution of Happiness Score (Histogram) ---
plt.figure(figsize=(10, 6))
plt.hist(df['HappinessScore'].dropna(), bins=20, color='skyblue', edgecolor='black')
plt.title('Distribution of Happiness Score')
plt.xlabel('Happiness Score')
plt.ylabel('Frequency')
plt.savefig('happiness_distribution.png')
plt.show()

# --- Plot 2: Average Happiness Score by Region (Bar Chart) ---
# Grouping data to find mean happiness per region
avg_happiness_region = df.groupby('Region')['HappinessScore'].mean().sort_values(ascending=False)

plt.figure(figsize=(12, 6))
sns.barplot(x=avg_happiness_region.index, y=avg_happiness_region.values, palette='viridis')
plt.title('Average Happiness Score by Region')
plt.xticks(rotation=45, ha='right')
plt.ylabel('Average Happiness Score')
plt.tight_layout()
plt.savefig('avg_happiness_region.png')
plt.show()

# --- Plot 3: Happiness Score vs Log GDP per capita (Scatter Plot) ---
plt.figure(figsize=(10, 6))
sns.scatterplot(data=df, x='Log GDP per capita', y='HappinessScore', hue='Region', alpha=0.7)
plt.title('Happiness Score vs Log GDP per capita')
plt.legend(bbox_to_anchor=(1.05, 1), loc='upper left')
plt.savefig('happiness_vs_gdp.png')
plt.show()

# --- Plot 4: Happiness Score Boxplot by Region (Box Plot) ---
plt.figure(figsize=(12, 6))
sns.boxplot(data=df, x='Region', y='HappinessScore', palette='Set3')
plt.title('Distribution of Happiness Scores by Region')
plt.xticks(rotation=45, ha='right')
plt.tight_layout()
plt.savefig('happiness_boxplot_region.png')
plt.show()

# --- Plot 5: Correlation Heatmap ---
# Calculates how variables relate to each other
plt.figure(figsize=(12, 10))
correlation_matrix = df.select_dtypes(include=['float64']).corr()
sns.heatmap(correlation_matrix, annot=True, cmap='coolwarm', fmt='.2f', linewidths=0.5)
plt.title('Correlation Heatmap of Dataset Variables')
plt.tight_layout()
plt.savefig('correlation_heatmap.png')
plt.show()
